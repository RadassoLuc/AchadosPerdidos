# Copie para .env (cp .env.example .env) e ajuste. NUNCA envie o .env ao GitHub.
PORT=3000
NODE_ENV=development
# URL pública do site (usada nos links dos e-mails)
APP_URL=http://localhost:3000
# Domínios permitidos no cadastro (aceita o domínio e seus subdomínios: aluno.uepa.br, uepa.br...)
ALLOWED_EMAIL_DOMAINS=uepa.br
# E-mails que viram ADMIN ao verificar a conta (separe por vírgula)
ADMIN_EMAILS=
# Dias até um item achado poder ser destinado (doação/descarte)
RETENTION_DAYS=90
# Dias até um "perdido" sem novidades expirar
PERDIDO_EXPIRA_DIAS=180
# Coloque true apenas atrás de proxy/Nginx confiável (para ler o IP real)
TRUST_PROXY=false
# E-mail: sem SMTP_HOST, os e-mails são gravados na pasta outbox/ (modo desenvolvimento)
SMTP_HOST=
SMTP_PORT=465
# tls (porta 465), starttls (porta 587) ou none (somente testes locais)
SMTP_SECURE=tls
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Achados e Perdidos UEPA <no-reply@exemplo.com>"
