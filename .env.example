# Copie para .env (cp .env.example .env) e ajuste. NUNCA envie o .env ao GitHub.
PORT=3000
NODE_ENV=development
# URL pública do site (usada nos links dos e-mails)
APP_URL=http://localhost:3000
# Domínios permitidos no cadastro (aceita o domínio e seus subdomínios: aluno.uepa.br, uepa.br...)
ALLOWED_EMAIL_DOMAINS=uepa.br
# E-mails que viram ADMIN ao verificar a conta (separe por vírgula)
ADMIN_EMAILS=
# Dias até um item achado poder ser destinado (doação/descarte)
RETENTION_DAYS=90
# Dias até um "perdido" sem novidades expirar
PERDIDO_EXPIRA_DIAS=180
# Coloque true apenas atrás de proxy/Nginx confiável (para ler o IP real)
TRUST_PROXY=false
# E-mail: sem SMTP_HOST, os e-mails são gravados na pasta outbox/ (modo desenvolvimento)
SMTP_HOST=
SMTP_PORT=465
# tls (porta 465), starttls (porta 587) ou none (somente testes locais)
SMTP_SECURE=tls
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Achados e Perdidos UEPA <no-reply@exemplo.com>"

# --- Login com Google (opcional; veja docs/DEPLOY.md) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Padrão: APP_URL + /api/auth/google/callback
GOOGLE_REDIRECT_URI=
# false = só entra com Google (sem cadastro por e-mail/senha, dispensa SMTP)
PASSWORD_AUTH=true

# --- Acessibilidade ---
# VLibras (tradutor de Libras do governo). Coloque false para desligar.
VLIBRAS=true
# Com VLibras ligado, a política de segurança libera vlibras.gov.br, 'unsafe-eval' e estilos inline (o VLibras precisa).
# Coloque VLIBRAS_CSP=estrita para não liberar eval/inline (o avatar de Libras pode então não abrir).
VLIBRAS_CSP=
# Extra: domínios/palavras adicionais para script-src, só se o console do navegador pedir
CSP_EXTRA_SCRIPT_SRC=

# --- Backup ---
BACKUP_DIR=./backups
# Em VPS com Caddy, use HOST=127.0.0.1 (só o Caddy acessa o app). Em Docker, deixe vazio.
HOST=
